{
  "name": "@oneunit/server",
  "version": "1.0.0",
  "description": "Fastify-based server bootstrap with optional plugins for logging, database, kafka, redis, and realtime.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js",
      "default": "./dist/bootstrap.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js",
      "default": "./dist/plugins/index.js"
    },
    "./routes": {
      "types": "./dist/routes/index.d.ts",
      "import": "./dist/routes/index.js",
      "default": "./dist/routes/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:basic": "npm run build && tsx examples/ts/basic.ts",
    "example:basic:ts": "npm run build && tsx examples/ts/basic.ts",
    "example:basic:js": "npm run build && node examples/js/basic.js",
    "example:plugins": "npm run build && tsx examples/ts/plugins.ts",
    "example:hooks": "npm run build && tsx examples/ts/hooks.ts",
    "example:custom": "npm run build && tsx examples/ts/custom.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "bootstrap",
    "framework",
    "node",
    "typescript",
    "server",
    "fastify",
    "api",
    "rest",
    "plugins"
  ],
  "author": "mayank",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayank040902/oneunit.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/mayank040902/oneunit/issues"
  },
  "homepage": "https://github.com/mayank040902/oneunit/tree/master/packages/server#readme",
  "dependencies": {
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/csrf-protection": "^8.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/request-context": "^7.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@fastify/under-pressure": "^9.0.0",
    "@msgpack/msgpack": "^3.1.3",
    "@oneunit/database": "workspace:*",
    "@oneunit/errors": "workspace:*",
    "@oneunit/kafka": "workspace:*",
    "@oneunit/logger": "workspace:*",
    "@oneunit/realtime": "workspace:*",
    "@oneunit/redis": "workspace:*",
    "@types/node": "^24.5.2",
    "dotenv": "^18.0.3",
    "fastify-type-provider-zod": "^7.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "undici": "^7.0.0",
    "vitest": "^3.2.4",
    "zod": "^4.1.11"
  },
  "peerDependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/csrf-protection": "^8.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/request-context": "^7.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@fastify/under-pressure": "^9.0.0",
    "@msgpack/msgpack": "^3.1.3",
    "@oneunit/database": "^1.0.0",
    "@oneunit/errors": "^1.0.0 || ^2.0.0",
    "@oneunit/kafka": "^1.0.0",
    "@oneunit/logger": "^1.0.0",
    "@oneunit/realtime": "^1.0.0",
    "@oneunit/redis": "^1.0.0",
    "dotenv": "^18.0.3",
    "fastify-type-provider-zod": "^7.0.0",
    "undici": "^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@fastify/compress": {
      "optional": true
    },
    "@fastify/cookie": {
      "optional": true
    },
    "@fastify/cors": {
      "optional": true
    },
    "@fastify/csrf-protection": {
      "optional": true
    },
    "@fastify/helmet": {
      "optional": true
    },
    "@fastify/multipart": {
      "optional": true
    },
    "@fastify/rate-limit": {
      "optional": true
    },
    "@fastify/request-context": {
      "optional": true
    },
    "@fastify/sensible": {
      "optional": true
    },
    "@fastify/swagger": {
      "optional": true
    },
    "@fastify/swagger-ui": {
      "optional": true
    },
    "@fastify/under-pressure": {
      "optional": true
    },
    "dotenv": {
      "optional": true
    },
    "fastify-type-provider-zod": {
      "optional": true
    },
    "@oneunit/logger": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "@oneunit/database": {
      "optional": true
    },
    "@oneunit/kafka": {
      "optional": true
    },
    "@oneunit/redis": {
      "optional": true
    },
    "@oneunit/realtime": {
      "optional": true
    },
    "@oneunit/errors": {
      "optional": true
    },
    "@msgpack/msgpack": {
      "optional": true
    },
    "undici": {
      "optional": true
    }
  }
}