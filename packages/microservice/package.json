{
  "name": "@oneunit/microservice",
  "version": "1.0.0",
  "description": "Secure microservice communication server with encrypted data sharing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "microservice",
    "communication",
    "encrypted",
    "secure",
    "message-broker"
  ],
  "author": "mayank",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@connectrpc/connect": "^1.5.0",
    "@connectrpc/connect-node": "^1.5.0",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.12",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "jose": "^5.2.0",
    "kafkajs": "^2.2.4",
    "nats.ws": "^1.30.3",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "uuid": "^11.1.1",
    "ws": "^8.16.0"
  },
  "peerDependencies": {
    "@oneunit/kafka": "^1.0.0",
    "@oneunit/redis": "^1.0.0",
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@oneunit/kafka": {
      "optional": true
    },
    "@oneunit/redis": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "zod": "^3.22.4"
  }
}
