{
  "name": "@oneunit/microservice",
  "version": "1.0.0",
  "description": "Secure microservice communication server with encrypted data sharing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters/logging/pino": {
      "import": "./dist/adapters/logging/pino/index.js",
      "types": "./dist/adapters/logging/pino/index.d.ts"
    },
    "./adapters/logging/oneunit": {
      "import": "./dist/adapters/logging/oneunit/index.js",
      "types": "./dist/adapters/logging/oneunit/index.d.ts"
    },
    "./adapters/messaging/kafka": {
      "import": "./dist/adapters/messaging/kafka/index.js",
      "types": "./dist/adapters/messaging/kafka/index.d.ts"
    },
    "./adapters/messaging/nats": {
      "import": "./dist/adapters/messaging/nats/index.js",
      "types": "./dist/adapters/messaging/nats/index.d.ts"
    },
    "./adapters/messaging/rabbitmq": {
      "import": "./dist/adapters/messaging/rabbitmq/index.js",
      "types": "./dist/adapters/messaging/rabbitmq/index.d.ts"
    },
    "./adapters/rpc/grpc": {
      "import": "./dist/adapters/rpc/grpc/index.js",
      "types": "./dist/adapters/rpc/grpc/index.d.ts"
    },
    "./registry/redis": {
      "import": "./dist/registry/redis/index.js",
      "types": "./dist/registry/redis/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run test && pnpm run typecheck && pnpm run lint",
    "pack:check": "pnpm run build && pnpm run typecheck && vitest run test/packaging.test.ts",
    "verify": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm test"
  },
  "keywords": [
    "microservice",
    "communication",
    "encrypted",
    "secure",
    "message-broker"
  ],
  "author": "mayank",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@connectrpc/connect": "^1.5.0",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.12",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "jose": "^5.2.0",
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "@oneunit/kafka": "^1.0.0",
    "@oneunit/logger": "^1.0.0",
    "@oneunit/redis": "^1.0.0",
    "amqplib": "^0.10.3",
    "ioredis": "^5.0.0",
    "kafkajs": "^2.2.4",
    "nats": "^2.28.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1"
  },
  "peerDependenciesMeta": {
    "@oneunit/kafka": {
      "optional": true
    },
    "@oneunit/logger": {
      "optional": true
    },
    "@oneunit/redis": {
      "optional": true
    },
    "amqplib": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "kafkajs": {
      "optional": true
    },
    "nats": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.11.0",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}