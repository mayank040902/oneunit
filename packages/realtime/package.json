{
  "name": "@oneunit/realtime",
  "version": "2.0.0",
  "description": "Local realtime WebSocket infrastructure: in-memory channels, backpressure, heartbeats, limits, auth hooks, a transport adapter, E2EE helpers, and an optional Fastify plugin. No broker included.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js",
      "default": "./dist/adapter.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js",
      "default": "./dist/fastify.js"
    },
    "./hub": {
      "types": "./dist/hub.d.ts",
      "import": "./dist/hub.js",
      "default": "./dist/hub.js"
    },
    "./e2ee": {
      "types": "./dist/e2ee.d.ts",
      "import": "./dist/e2ee.js",
      "default": "./dist/e2ee.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "LICENSE",
    "README.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');for(const p of ['dist','tsconfig.tsbuildinfo'])fs.rmSync(p,{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "npm run typecheck:src && npm run typecheck:test && npm run typecheck:examples",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "example:chat": "tsx examples/chat.ts",
    "example:client": "tsx examples/client.ts",
    "example:standalone": "tsx examples/standalone.ts",
    "example:plugin-ws": "tsx examples/plugin-ws.ts",
    "example:e2ee": "tsx examples/e2ee.ts",
    "example:e2ee-client": "tsx examples/e2ee-client.ts",
    "example:adapter": "tsx examples/adapter.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run build && npm run typecheck && npm run lint && npm test && npm run pack:check"
  },
  "keywords": [
    "realtime",
    "websocket",
    "websockets",
    "channels",
    "pubsub",
    "fanout",
    "backpressure",
    "heartbeat",
    "e2ee",
    "encryption",
    "nodejs",
    "adapter",
    "oneunit"
  ],
  "author": "mayank",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayank040902/oneunit.git",
    "directory": "packages/realtime"
  },
  "bugs": {
    "url": "https://github.com/mayank040902/oneunit/issues"
  },
  "homepage": "https://github.com/mayank040902/oneunit/tree/master/packages/realtime#readme",
  "dependencies": {
    "libsodium-wrappers": "^0.8.4",
    "notepack.io": "^3.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@fastify/websocket": "^11.3.1",
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1",
    "eslint": "^9.22.0",
    "fastify": "^5.12.5",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@fastify/websocket": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  }
}
