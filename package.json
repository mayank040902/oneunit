{
  "name": "@oneunit",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Node.js packages published independently as @oneunit/*",
  "scripts": {
    "build": "pnpm -r run build",
    "example:combined": "pnpm --filter @oneunit/combined-example start",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "lint": "eslint . --ignore-pattern '**/.kilo/**'",
    "pack:check": "pnpm -r run pack:check",
    "publish:packages": "pnpm -r publish --access public",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "keywords": [
    "oneunit",
    "node",
    "typescript",
    "fastify",
    "microservices",
    "logging"
  ],
  "author": "mayank",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayank040902/oneunit.git"
  },
  "bugs": {
    "url": "https://github.com/mayank040902/oneunit/issues"
  },
  "homepage": "https://github.com/mayank040902/oneunit#readme",
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1",
    "globals": "^14.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
